          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "mvp-travel-prod",
          "appId": "1:976469473142:android:e5f8337952e42d82dbac57",
