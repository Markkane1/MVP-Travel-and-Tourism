        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "mvp-travel-prod",
          "configurations": {
            "android": "1:976469473142:android:e5f8337952e42d82dbac57",
            "ios": "1:976469473142:ios:a818ab878c83188cdbac57",
            "web": "1:976469473142:web:ae9744f6b3dc3c34dbac57"
