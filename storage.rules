rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
          && request.auth.token.keys().hasAll(['admin'])
          && request.auth.token.admin == true;
    }

    // Scopes storage access to user-specific folders
    match /users/{uid}/{allPaths=**} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      
      // Uploads restricted to the owner, size limit < 10MB, and content must be image.
      allow create, update: if isAuthenticated() 
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }

    match /concierge_threads/{uid}/attachments/{allPaths=**} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAuthenticated() 
                   && (request.auth.uid == uid || isAdmin())
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
    }

    // SECURITY FIX #13: Public tour/service marketing images are served from the
    // 'public/' prefix. The 'admin/' prefix is now admin-read-only — any sensitive
    // operational files uploaded here will NOT be publicly accessible.
    match /public/{allPaths=**} {
      allow read: if true; // Public marketing content (tour images, service images)
      allow create, update: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // SECURITY FIX #13: admin/ namespace is now locked to authenticated admins only.
    // Do NOT add 'allow read: if true' here — this path may contain sensitive uploads.
    match /admin/{allPaths=**} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
