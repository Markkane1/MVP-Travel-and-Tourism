rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Scopes storage access to user-specific folders
    match /users/{uid}/{allPaths=**} {
      // Anyone can read images (profile photos, review photos)
      allow read;
      
      // Uploads restricted to the owner, size limit < 10MB, and content must be image.
      allow write: if request.auth != null 
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
