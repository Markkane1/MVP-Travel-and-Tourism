rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication checks
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.super_admin == true;
    }

    // --- Admin & Staff Collections ---
    match /staff_profiles/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isSuperAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write audit logs
    }

    // --- User Profiles ---
    match /users/{uid} {
      // Admins can read all users
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);

      match /savedTours/{tourId} {
        allow read, write: if isOwner(uid);
      }
      match /paymentMethods/{paymentMethodId} {
        allow read, write: if isOwner(uid);
      }
    }

    // --- Bookings ---
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['stripePaymentIntentId', 'bookingReferenceCode', 'reviewed'])
        && (!request.resource.data.keys().hasAll(['pickupLocation']) || request.resource.data.pickupLocation.size() <= 200)
        && (!request.resource.data.keys().hasAll(['specialRequests']) || request.resource.data.specialRequests.size() <= 500);
        
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'stripePaymentIntentId', 'bookingReferenceCode', 'reviewed'])
        && (!request.resource.data.keys().hasAll(['pickupLocation']) || request.resource.data.pickupLocation.size() <= 200)
        && (!request.resource.data.keys().hasAll(['specialRequests']) || request.resource.data.specialRequests.size() <= 500);

      allow delete: if false;
    }

    // --- Tours Catalog ---
    match /tours/{tourId} {
      allow read: if true;
      allow write: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated(); // Simplified for v1, could be constrained to booking completion
      }
    }

    // --- Services Catalog ---
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Concierge ---
    match /concierges/{conciergeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /concierge_threads/{uid} {
      // Admins can read all threads
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false; // Metadata updates via Cloud Functions
      
      match /messages/{messageId} {
        allow read: if isOwner(uid) || isAdmin();
        
        // Users can send messages directly. Admins use Cloud Function `adminReplyToConciergeThread`.
        allow create: if isOwner(uid)
          && request.resource.data.senderType == 'user'
          && request.resource.data.text.size() <= 1000;
          
        allow update, delete: if false;
      }
    }

    // --- Notifications ---
    match /notifications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
      
      match /items/{notificationId} {
        allow read: if isOwner(uid) || isAdmin();
        allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create: if false; // Handled by Cloud Functions
        allow delete: if false;
      }
    }
  }
}
