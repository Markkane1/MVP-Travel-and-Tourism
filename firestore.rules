rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isBootstrapAdmin() {
      return isAuthenticated() && request.auth.token.email == 'admin@mvptravel.com';
    }

    function hasStaffProfile() {
      return exists(/databases/$(database)/documents/staff_profiles/$(request.auth.uid));
    }

    function isAdmin() {
      return isBootstrapAdmin() || hasStaffProfile();
    }

    function isSuperAdmin() {
      return isBootstrapAdmin() || (
        hasStaffProfile() && get(/databases/$(database)/documents/staff_profiles/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    // ─── Staff & Admin Collections ──────────────────────────────────────────
    match /staff_profiles/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      // super_admin can create/update staff profiles directly (no Cloud Function needed)
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    // Audit logs: admins can read; admin clients write their own audit entries.
    // No update or delete — audit logs are append-only.
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ─── User Profiles ──────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Users manage their own profile; admins can only update safe fields.
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        || (isAdmin()
          && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['tier', 'loyaltyPoints', 'conciergeId', 'updatedAt']));
      allow delete: if false;

      match /savedTours/{tourId} {
        allow read, write: if isOwner(uid);
      }
      match /paymentMethods/{paymentMethodId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ─── Bookings ────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['stripePaymentIntentId', 'bookingReferenceCode', 'reviewed'])
        && (!request.resource.data.keys().hasAll(['pickupLocation']) || request.resource.data.pickupLocation.size() <= 200)
        && (!request.resource.data.keys().hasAll(['specialRequests']) || request.resource.data.specialRequests.size() <= 500);

      // Customers update their own non-sensitive fields; admins update status + admin metadata.
      allow update: if (isAuthenticated()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['status', 'stripePaymentIntentId', 'bookingReferenceCode', 'reviewed'])
          && (!request.resource.data.keys().hasAll(['pickupLocation']) || request.resource.data.pickupLocation.size() <= 200)
          && (!request.resource.data.keys().hasAll(['specialRequests']) || request.resource.data.specialRequests.size() <= 500))
        || (isAdmin()
          && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['status', 'adminNotes', 'lastAdminActionAt', 'lastAdminActionBy', 'refundRequested', 'refundReason']));

      allow delete: if false;
    }

    // ─── Tours Catalog ───────────────────────────────────────────────────────
    match /tours/{tourId} {
      allow read: if true;
      allow write: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated();
      }
    }

    // ─── Services Catalog ────────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Concierge ────────────────────────────────────────────────────────────
    match /concierges/{conciergeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /concierge_threads/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Admins can update thread metadata (lastMessageAt, isResolved) directly.
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        || (isAdmin()
          && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['lastMessageAt', 'isResolved', 'updatedAt']));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isOwner(uid) || isAdmin();

        // Users send as 'user'; admins send as 'staff'.
        allow create: if (isOwner(uid)
            && request.resource.data.senderType == 'user'
            && request.resource.data.text.size() <= 1000)
          || (isAdmin()
            && request.resource.data.senderType == 'staff'
            && request.resource.data.text.size() <= 2000);

        allow update, delete: if false;
      }
    }

    // ─── Notifications ────────────────────────────────────────────────────────
    match /notifications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Admins can create the root notification doc if needed.
      allow create: if isAdmin();
      allow update, delete: if false;

      match /items/{notificationId} {
        allow read: if isOwner(uid) || isAdmin();
        // Users can mark as read; admins can create notification items directly.
        allow create: if isAdmin();
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if false;
      }
    }
  }
}
