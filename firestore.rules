rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function staffProfile() {
      return get(/databases/$(database)/documents/staff_profiles/$(request.auth.uid)).data;
    }

    function hasActiveStaffProfile() {
      return isAuthenticated()
          && exists(/databases/$(database)/documents/staff_profiles/$(request.auth.uid))
          && staffProfile().isActive == true;
    }

    function isAdmin() {
      return hasActiveStaffProfile()
          && request.auth.token.keys().hasAll(['admin'])
          && request.auth.token.admin == true;
    }

    function isSuperAdmin() {
      return hasActiveStaffProfile()
          && request.auth.token.keys().hasAll(['super_admin'])
          && request.auth.token.super_admin == true
          && staffProfile().role == 'super_admin';
    }

    // ─── Staff & Admin Collections ──────────────────────────────────────────
    match /staff_profiles/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    // SECURITY FIX #10: admin_audit_logs are now backend-write-only.
    // Direct client creates are no longer permitted. All audit events must
    // be emitted by trusted Cloud Functions.
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ─── User Profiles ──────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
          && (!request.resource.data.keys().hasAll(['bio']) || request.resource.data.bio.size() <= 500);
      allow update: if (isOwner(uid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tier', 'loyaltyPoints', 'conciergeId'])
            && (!request.resource.data.keys().hasAll(['bio']) || request.resource.data.bio.size() <= 500))
          || (isAdmin()
            && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['tier', 'loyaltyPoints', 'conciergeId', 'updatedAt']));
      allow delete: if false;

      match /savedTours/{tourId} {
        allow read, write: if isOwner(uid);
      }
      match /paymentMethods/{paymentMethodId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ─── Bookings ────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['stripePaymentIntentId', 'bookingReferenceCode', 'reviewed'])
        && (!request.resource.data.keys().hasAll(['pickupLocation']) || request.resource.data.pickupLocation.size() <= 200)
        && (!request.resource.data.keys().hasAll(['specialRequests']) || request.resource.data.specialRequests.size() <= 500);

      // Customers update their own non-sensitive fields; admins update status + admin metadata.
      allow update: if (isAuthenticated()
            && resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
            && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['status', 'stripePaymentIntentId', 'bookingReferenceCode', 'reviewed'])
            && (!request.resource.data.keys().hasAll(['pickupLocation']) || request.resource.data.pickupLocation.size() <= 200)
            && (!request.resource.data.keys().hasAll(['specialRequests']) || request.resource.data.specialRequests.size() <= 500))
          || (isAdmin()
            && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['status', 'adminNotes', 'lastAdminActionAt', 'lastAdminActionBy', 'refundRequested', 'refundReason']));

      allow delete: if false;
    }

    // ─── Tours Catalog ───────────────────────────────────────────────────────
    match /tours/{tourId} {
      allow read: if true;
      allow write: if isAdmin();

      // SECURITY FIX #2: Review creation now enforces:
      //   1. Caller owns the booking (bookingId in request must match userId)
      //   2. The booking must have status == 'completed' (verified server-side by the trigger)
      //   3. The booking must belong to this tourId
      //   4. The booking must not already be reviewed
      //   5. Field alignment: 'comment' (not 'text') is the actual client field
      //   6. One review per booking is enforced by the trigger (reviewed flag)
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.bookingId is string
            && request.resource.data.bookingId.size() > 0
            // Verify the booking belongs to this caller and is completed
            && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == request.auth.uid
            && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'completed'
            && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.tourId == tourId
            && (!get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.keys().hasAll(['reviewed'])
                || get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.reviewed != true)
            // Comment field with length guard (client uses 'comment' not 'text')
            && request.resource.data.comment is string
            && request.resource.data.comment.size() <= 2000;
        allow update: if isAuthenticated()
            && resource.data.userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.comment is string
            && request.resource.data.comment.size() <= 2000;
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    // ─── Services Catalog ────────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Concierge ────────────────────────────────────────────────────────────
    match /concierges/{conciergeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /concierge_threads/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isResolved', 'lastMessageSender', 'lastMessageAt', 'lastMessageText']))
          || (isAdmin()
            && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['lastMessageAt', 'isResolved', 'updatedAt']));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isOwner(uid) || isAdmin();

        allow create: if (isOwner(uid)
              && request.resource.data.senderType == 'user'
              && request.resource.data.senderId == request.auth.uid
              && request.resource.data.text.size() <= 1000)
            || (isAdmin()
              && request.resource.data.senderType == 'staff'
              && request.resource.data.text.size() <= 2000);

        allow update, delete: if false;
      }
    }

    // ─── Notifications ────────────────────────────────────────────────────────
    match /notifications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;

      match /items/{notificationId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isAdmin();
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if false;
      }
    }
  }
}
